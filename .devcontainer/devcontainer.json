{
  "name": "Developer 10x · Telón",
  "dockerComposeFile": ["../infra/compose.yaml", "compose.devcontainer.yaml"],
  "service": "workspace",
  "runServices": ["postgres", "redis", "mailpit", "workspace"],
  "workspaceFolder": "/workspaces/developer-10x",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "forwardPorts": [5173, 5174, 8025, 3000, 3001, 5175],
  "portsAttributes": {
    "5173": { "label": "Tienda", "onAutoForward": "notify" },
    "5174": { "label": "Backoffice", "onAutoForward": "notify" },
    "8025": { "label": "Mailpit", "onAutoForward": "notify" },
    "3000": { "label": "API", "onAutoForward": "silent" },
    "3001": { "label": "Pagos (emulada)", "onAutoForward": "silent" },
    "5175": { "label": "Editor (microfrontend)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq postgresql-client && make setup",
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat", "dbaeumer.vscode-eslint", "vitest.explorer"]
    }
  }
}
