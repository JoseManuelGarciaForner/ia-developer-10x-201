# Configuración del curso. Copia este fichero a .env (no se versiona) y ajústalo.

# M06 — dónde viven los remotos de los repos heredados
#   local  : repos bare en workspace/m06/remotes/ (por defecto, sin red ni credenciales)
#   github : repos en tu cuenta de GitHub (necesitas `gh auth login`); permite pull requests reales
M06_REMOTE_MODE=local
# Solo modo github: tu usuario u organización, prefijo de los repos y visibilidad
M06_GH_OWNER=
M06_GH_PREFIX=telon-legado-
M06_GH_VISIBILITY=private
